FROM odoo@sha256:c01e5bc381f087a3be2800d65cff8ad51ab0709dc54c3b81cd9b0d6c9b3a4d77
USER root
COPY deploy/odoo-single-node/odoo-entrypoint.sh /usr/local/bin/woa-odoo-entrypoint
COPY deploy/odoo-single-node/init-odoo.sh /usr/local/bin/init-woa-odoo
COPY deploy/odoo-single-node/qualification-users.sh /usr/local/bin/woa-qualification-users
COPY deploy/odoo-single-node/qualification-users.py /usr/local/lib/woa-qualification-users.py
RUN install -d -m 0700 -o root -g root /run/woa-input \
    && chmod 0755 /usr/local/bin/woa-odoo-entrypoint /usr/local/bin/init-woa-odoo \
                  /usr/local/bin/woa-qualification-users
ENTRYPOINT ["/usr/local/bin/woa-odoo-entrypoint"]
CMD ["odoo", "--config=/run/woa-private/odoo.conf"]
