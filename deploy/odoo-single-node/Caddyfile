{
	admin off
	skip_install_trust
	auto_https disable_redirects
	servers {
		timeouts {
			read_body 30s
			read_header 10s
			idle 5m
		}
	}
}

https://{$WOA_HOSTNAME:localhost}:8443 {
	tls internal
	encode zstd gzip

	handle_path /assistant/* {
		@bootstrap path /bootstrap
		reverse_proxy @bootstrap agent:8767

		@health path /healthz
		reverse_proxy @health agent:8766

		# Same-origin browser GETs do not carry Origin. This trusted, loopback-only
		# application ingress supplies the configured origin only when it is absent;
		# an explicit cross-origin value remains visible to the core origin check.
		@same_origin_gateway {
			path /v1/*
			not header Origin *
		}
		request_header @same_origin_gateway Origin {$WOA_PUBLIC_ORIGIN:https://localhost:8443}

		@gateway path /v1/*
		reverse_proxy @gateway agent:8766 {
			flush_interval -1
			transport http {
				response_header_timeout 35s
			}
		}
	}

	handle {
		reverse_proxy odoo:8069
	}

	handle_errors {
		@upstream_unavailable expression {http.error.status_code} == 502
		respond @upstream_unavailable "Service temporarily unavailable" 503
	}
}
