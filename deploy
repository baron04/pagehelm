#!/bin/sh
# Routine deployment from this checkout; configuration is read by the Python entry point.
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -x "$ROOT/.venv/bin/python" ]; then
  PYTHON="$ROOT/.venv/bin/python"
elif command -v python3.12 >/dev/null 2>&1; then
  PYTHON=python3.12
else
  echo '需要 Python 3.12：请先按 README 创建 .venv。' >&2
  exit 2
fi
exec "$PYTHON" "$ROOT/examples/yudao/deploy/cloud/command.py" "$@"
