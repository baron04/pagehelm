{
  "comment": [
    "One palette, two renderers: the React panel compiles these into :root custom",
    "properties, and traceview writes the same properties into its replay page. Contrast",
    "ratios are asserted by tests/test_panel_contract.py, so a colour cannot be changed",
    "into an inaccessible one without a gate going red.",
    "Dark is defined outright, not derived by inversion."
  ],
  "scale": {
    "space": "4px",
    "font-size": "13px",
    "font-size-small": "12px",
    "font-size-title": "15px",
    "font-size-meta": "11px",
    "font-size-micro": "10px",
    "line-height": "1.5",
    "radius-inline": "4px",
    "radius-control": "6px",
    "radius-card": "8px",
    "radius-panel": "10px",
    "radius-window": "14px",
    "radius-pill": "999px",
    "border-width": "1px",
    "motion-fast": "120ms",
    "motion-base": "180ms",
    "motion-easing": "cubic-bezier(0.16, 1, 0.3, 1)",
    "font-stack": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', Roboto, Helvetica, Arial, sans-serif",
    "mono-stack": "ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace"
  },
  "themes": {
    "light": {
      "bg": "#ffffff",
      "surface": "#fbfbfc",
      "surface-muted": "#f3f4f6",
      "surface-raised": "#ffffff",
      "ink": "#16181d",
      "ink-muted": "#585f6d",
      "ink-faint": "#6b7280",
      "line": "#e3e5ea",
      "line-strong": "#cfd3da",
      "accent": "#1d4ed8",
      "accent-hover": "#1a43bd",
      "accent-ink": "#ffffff",
      "accent-soft": "#eef2ff",
      "focus": "#1d4ed8",
      "brand-top": "#537bea",
      "brand-mid": "#1d4ed8",
      "brand-bottom": "#163ba1",
      "brand-ink": "#ffffff",
      "danger": "#b42318",
      "danger-soft": "#fef3f2",
      "success": "#067647",
      "success-soft": "#ecfdf3",
      "warning": "#b54708",
      "warning-soft": "#fffaeb",
      "warning-ink": "#ffffff",
      "overlay": "rgba(16, 18, 23, 0.32)",
      "sheen-edge": "rgba(255, 255, 255, 0.55)",
      "sheen-fill": "rgba(255, 255, 255, 0.16)",
      "shadow-1": "0 1px 2px rgba(16, 18, 23, 0.06)",
      "shadow-2": "0 8px 24px rgba(16, 18, 23, 0.10)"
    },
    "dark": {
      "bg": "#0f1115",
      "surface": "#14171d",
      "surface-muted": "#1a1e26",
      "surface-raised": "#1b1f28",
      "ink": "#e8eaf0",
      "ink-muted": "#a0a7b6",
      "ink-faint": "#8b93a3",
      "line": "#272c36",
      "line-strong": "#343a46",
      "accent": "#7aa2ff",
      "accent-hover": "#93b4ff",
      "accent-ink": "#0b1020",
      "accent-soft": "#1a2136",
      "focus": "#7aa2ff",
      "brand-top": "#537bea",
      "brand-mid": "#1d4ed8",
      "brand-bottom": "#163ba1",
      "brand-ink": "#ffffff",
      "danger": "#f97066",
      "danger-soft": "#2a1613",
      "success": "#47cd89",
      "success-soft": "#0f2419",
      "warning": "#fdb022",
      "warning-soft": "#2a1f0b",
      "warning-ink": "#1a1205",
      "overlay": "rgba(0, 0, 0, 0.55)",
      "sheen-edge": "rgba(255, 255, 255, 0.08)",
      "sheen-fill": "rgba(255, 255, 255, 0.05)",
      "shadow-1": "0 1px 2px rgba(0, 0, 0, 0.5)",
      "shadow-2": "0 8px 24px rgba(0, 0, 0, 0.55)"
    }
  },
  "contrast_requirements": [
    {"foreground": "ink", "background": "bg", "minimum": 7.0},
    {"foreground": "ink", "background": "surface", "minimum": 7.0},
    {"foreground": "ink", "background": "surface-muted", "minimum": 7.0},
    {"foreground": "ink-muted", "background": "bg", "minimum": 4.5},
    {"foreground": "ink-muted", "background": "surface", "minimum": 4.5},
    {"foreground": "ink-muted", "background": "surface-muted", "minimum": 4.5},
    {"foreground": "ink-faint", "background": "surface", "minimum": 4.5},
    {"foreground": "accent", "background": "bg", "minimum": 4.5},
    {"foreground": "accent", "background": "surface", "minimum": 4.5},
    {"foreground": "accent-ink", "background": "accent", "minimum": 4.5},
    {"foreground": "brand-ink", "background": "brand-mid", "minimum": 4.5},
    {"foreground": "warning-ink", "background": "warning", "minimum": 4.5},
    {"foreground": "danger", "background": "bg", "minimum": 4.5},
    {"foreground": "danger", "background": "danger-soft", "minimum": 4.5},
    {"foreground": "success", "background": "bg", "minimum": 4.5},
    {"foreground": "success", "background": "success-soft", "minimum": 4.5},
    {"foreground": "warning", "background": "bg", "minimum": 4.5},
    {"foreground": "warning", "background": "warning-soft", "minimum": 4.5},
    {"foreground": "focus", "background": "bg", "minimum": 3.0},
    {"foreground": "line-strong", "background": "surface", "minimum": 1.4}
  ]
}
