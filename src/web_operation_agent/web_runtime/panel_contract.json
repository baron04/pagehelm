{
  "protocol": 1,
  "comment": [
    "The one source of truth for everything the assistant panel and the embedded Runtime",
    "must agree on. The server validates against this file, the panel imports it, and",
    "tests/test_panel_contract.py refuses any value that only one side knows about.",
    "A constant that lives in two places drifts; F8b is what that costs."
  ],
  "panel_states": {
    "connecting": "neutral",
    "ready": "ready",
    "queued": "active",
    "observing": "active",
    "acting": "active",
    "stopping": "warning",
    "reconnecting": "warning",
    "awaiting_confirmation": "warning",
    "success": "success",
    "cancelled": "neutral",
    "refused": "error",
    "indeterminate": "warning",
    "error": "error",
    "ended": "neutral",
    "replaced": "neutral"
  },
  "tones": ["neutral", "ready", "active", "warning", "success", "error"],
  "progress_states": {
    "waiting_for_runtime": {"panel_state": "connecting", "tone": "neutral", "terminal": false},
    "session_recovered": {"panel_state": "ready", "tone": "warning", "terminal": false},
    "message_accepted": {"panel_state": "queued", "tone": "neutral", "terminal": false},
    "new_conversation": {"panel_state": "ready", "tone": "neutral", "terminal": false},
    "agent_started": {"panel_state": "acting", "tone": "active", "terminal": false},
    "approval_recorded": {"panel_state": "acting", "tone": "neutral", "terminal": false},
    "cancelling": {"panel_state": "stopping", "tone": "warning", "terminal": false},
    "finished": {"panel_state": "success", "tone": "success", "terminal": true},
    "refused": {"panel_state": "refused", "tone": "error", "terminal": true},
    "cancelled": {"panel_state": "cancelled", "tone": "neutral", "terminal": true},
    "indeterminate": {"panel_state": "indeterminate", "tone": "warning", "terminal": true},
    "failed": {"panel_state": "error", "tone": "error", "terminal": true},
    "task_failed": {"panel_state": "error", "tone": "error", "terminal": true}
  },
  "entry_kinds": ["goal", "progress", "action", "result", "approval", "notice"],
  "limits": {
    "composer_max_chars": 2000,
    "history_page_size": 80,
    "rendered_entry_budget": 1500,
    "effect_max_chars": 300,
    "target_max_chars": 300,
    "max_targets": 24,
    "notice_max_chars": 300,
    "label_max_chars": 200,
    "goal_max_chars": 2000,
    "result_max_chars": 4000
  },
