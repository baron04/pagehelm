#!/bin/sh
# Start environment 1, or select environment 2 with --env 2.
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ ! -x "$ROOT/.venv/bin/python" ]; then
  echo '缺少 .venv；请按 docs/guides/local-yudao.md 完成首次准备。' >&2
  exit 2
fi
PYTHON="$ROOT/.venv/bin/python"
. "$ROOT/scripts/python.sh"
exec "$PYTHON" "$ROOT/examples/yudao/deploy/local/command.py" "$@"
