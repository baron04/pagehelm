# Third-party assets, fetched by `python -m web_operation_agent_odoo.deploy provision` from
# the npm release pinned in web_operation_agent/policies/page_controller.json and checked
# by digest. They are deliberately not tracked: this repository serves them, it does not
# redistribute them, and a committed copy would drift from the pin without anyone noticing.
# view-bridge.js and page-read-state.js are generated first-party serving copies;
# their canonical sources live under frontend/src/integrations/odoo/.
*
!.gitignore
!loader.js
!page-controller-with-state.js
!page-facets.js
!facet-bridge.js
!record-bridge.js
!page-record-route.js
!page-blocker.js
