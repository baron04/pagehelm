<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
    The assistant on every signed-in backend page starts with a small Odoo-owned shell. The
    shell is independent of the Agent, so it can still show startup errors and retry when the
    Agent Runtime is missing or unavailable.

    The shell imports the versioned `assistant.js` from the Agent. That Runtime asks this addon
    for identity and owns normal startup, renewal, reconnection and the full panel. The login
    page does not render `web.webclient_bootstrap`, so nobody signed out sees the shell.
    -->
    <template id="assistant_entry" inherit_id="web.webclient_bootstrap" name="Web Operation Agent assistant">
        <xpath expr="//t[@t-set='head_web']" position="inside">
            <script type="module" src="/woa_runtime/static/src/loader.js?v=1.4"
                    data-woa-runtime="/assistant/v1/runtime/assistant.js"
                    data-woa-identity="/woa/session-assertion"
                    data-woa-bootstrap="/assistant/bootstrap"/>
        </xpath>
    </template>
</odoo>
