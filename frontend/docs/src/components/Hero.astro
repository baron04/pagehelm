---
import StarlightHero from '@astrojs/starlight/components/Hero.astro';
import avatar from '../assets/assistant-avatar.webp';

const { starlightRoute } = Astro.locals;
const entry = starlightRoute.entry;
const isSplash = entry.data.template === 'splash';
const isZh = (starlightRoute.lang || '').toLowerCase().startsWith('zh');

const rawBase = import.meta.env.BASE_URL || '/';
const basePrefix = rawBase === '/' ? '' : rawBase.replace(/\/+$/, '');
const routePath = (rel: string) =>
  `${basePrefix}/${rel.replace(/^\/+/, '')}`.replace(/\/{2,}/g, '/');
const docPrefix = isZh ? 'zh-cn/' : '';

const copy = isZh
  ? {
      eyebrow: 'Alpha · Python 3.13 + TypeScript',
      title: 'PageHelm',
      lead:
        '面向第一方 Web 应用的页面操作 AI Agent。服务端负责模型规划、权限边界与审计，浏览器负责同源页面观测、交互与可见审批。',
      ctaPrimary: '运行本地示例',
      ctaSecondary: '查看架构与边界',
      greet: {
        label: 'PageHelm 助手面板预览',
        intro: '你好，我是 PageHelm',
        title: '有什么可以帮你？',
        detail: '可以帮你查数据、操作页面，或替你编辑数据。',
        examples: [
          { kind: 'query', label: '查询数据', text: '「CRM 联系人一共有多少个？」' },
          { kind: 'operate', label: '页面操作', text: '「打开合同管理页面」' },
          { kind: 'edit', label: '编辑数据', text: '「新建一个 CRM 客户，名称叫星辰科技」' },
        ],
      },
    }
  : {
      eyebrow: 'Alpha · Python 3.13 + TypeScript',
      title: 'PageHelm',
      lead:
        'An AI agent for operating first-party web applications. The server owns planning, policy, and audit state; the browser handles same-origin observation, UI actions, and visible write approvals.',
      ctaPrimary: 'Run local demo',
      ctaSecondary: 'Architecture & boundaries',
      greet: {
        label: 'PageHelm assistant panel preview',
        intro: "Hi, I'm PageHelm",
        title: 'How can I help?',
        detail: 'I can look up data, work the page, or edit records for you.',
        examples: [
          { kind: 'query', label: 'Query data', text: '“How many CRM contacts are there?”' },
          { kind: 'operate', label: 'Page action', text: '“Open the contract management page”' },
          { kind: 'edit', label: 'Edit data', text: '“Create a CRM customer named Xingchen Tech”' },
        ],
      },
    };
---

{isSplash ? (
  <section class="ph-hero">
    <div class="ph-hero-copy">
      <span class="ph-eyebrow">{copy.eyebrow}</span>
      <h1 class="ph-hero-title">{copy.title}</h1>
      <p class="ph-hero-lead">{copy.lead}</p>
      <div class="ph-hero-actions">
        <a class="ph-btn ph-btn-primary" href={routePath(`${docPrefix}integration/quickstart/`)}>
          {copy.ctaPrimary}
        </a>
        <a class="ph-btn ph-btn-secondary" href={routePath(`${docPrefix}architecture/overview/`)}>
          {copy.ctaSecondary}
        </a>
      </div>
    </div>

    <aside class="ph-greet" aria-label={copy.greet.label}>
      <div class="ph-greet-top">
        <img class="ph-greet-avatar" src={avatar.src} width="88" height="88" alt="" />
        <span class="ph-greet-bubble">{copy.greet.intro}</span>
      </div>
      <p class="ph-greet-title">{copy.greet.title}</p>
      <p class="ph-greet-detail">{copy.greet.detail}</p>
      <ul class="ph-greet-examples">
        {copy.greet.examples.map((example) => (
          <li class="ph-greet-example" data-kind={example.kind}>
            <span class="ph-greet-badge">{example.label}</span>
            <span class="ph-greet-text">{example.text}</span>
          </li>
        ))}
      </ul>
    </aside>
  </section>
) : (
  <StarlightHero />
)}
