---
import StarlightHero from '@astrojs/starlight/components/Hero.astro';

const { starlightRoute } = Astro.locals;
const entry = starlightRoute.entry;
const isSplash = entry.data.template === 'splash';
const isZh = (starlightRoute.lang || '').toLowerCase().startsWith('zh');

const rawBase = import.meta.env.BASE_URL || '/';
const basePrefix = rawBase === '/' ? '' : rawBase.replace(/\/+$/, '');
const routePath = (rel: string) =>
  `${basePrefix}/${rel.replace(/^\/+/, '')}`.replace(/\/{2,}/g, '/');
const docPrefix = isZh ? 'zh-cn/' : '';

const copy = isZh
  ? {
      eyebrow: 'Alpha · Python 3.13 + TypeScript',
      title: 'PageHelm',
      lead:
        '嵌入第一方 Web 应用的 AI 操作框架。服务端负责模型规划、权限边界与审计，浏览器负责同源页面观测、交互与可见审批。',
      ctaPrimary: '运行本地示例',
      ctaSecondary: '查看架构与边界',
      diagramTitle: '三层信任边界',
      layers: [
        {
          role: '浏览器 Runtime',
          detail: '同源挂载面板，上报页面快照与动作回执；不持有模型密钥或规划逻辑。',
        },
        {
          role: '服务端核心',
          detail: '应用无关的决策循环、权限开关、单次审批管道与 SQLite 审计账本。',
        },
        {
          role: '业务适配器',
          detail: '绑定登录身份、站内路由、同账号只读查询与经核验的写入操作。',
        },
      ],
    }
  : {
      eyebrow: 'Alpha · Python 3.13 + TypeScript',
      title: 'PageHelm',
      lead:
        'An embedded AI operations framework for first-party web applications. The server owns planning, policy, and audit state; the browser handles same-origin observation, UI actions, and visible write approvals.',
      ctaPrimary: 'Run local demo',
      ctaSecondary: 'Architecture & boundaries',
      diagramTitle: 'Three-Layer Trust Boundary',
      layers: [
        {
          role: 'Browser Runtime',
          detail: 'Mounts the same-origin panel and sends page observations and action receipts; holds no model keys or plans.',
        },
        {
          role: 'Application-Neutral Server',
          detail: 'Owns the turn loop, safety mode policy, single-consume write pipeline, and SQLite audit journals.',
        },
        {
          role: 'Application Adapter',
          detail: 'Binds actor identity, allowed routes, same-actor read tools, and postcondition-verified writes.',
        },
      ],
    };
---

{isSplash ? (
  <section class="ph-hero">
    <div class="ph-hero-copy">
      <span class="ph-eyebrow">{copy.eyebrow}</span>
      <h1 class="ph-hero-title">{copy.title}</h1>
      <p class="ph-hero-lead">{copy.lead}</p>
      <div class="ph-hero-actions">
        <a class="ph-btn ph-btn-primary" href={routePath(`${docPrefix}integration/quickstart/`)}>
          {copy.ctaPrimary}
        </a>
        <a class="ph-btn ph-btn-secondary" href={routePath(`${docPrefix}architecture/overview/`)}>
          {copy.ctaSecondary}
        </a>
      </div>
    </div>

    <aside class="ph-boundary-card" aria-label={copy.diagramTitle}>
      <div class="ph-boundary-head">{copy.diagramTitle}</div>
      <ol class="ph-boundary-list">
        {copy.layers.map((layer, index) => (
          <li class="ph-boundary-item">
            <span class="ph-boundary-index">0{index + 1}</span>
            <div>
              <strong>{layer.role}</strong>
              <p>{layer.detail}</p>
            </div>
          </li>
        ))}
      </ol>
    </aside>
  </section>
) : (
  <StarlightHero />
)}
