    {"foreground": "ink-muted", "background": "surface-muted", "minimum": 4.5},
    {"foreground": "ink-faint", "background": "surface", "minimum": 4.5},
    {"foreground": "accent", "background": "bg", "minimum": 4.5},
    {"foreground": "accent", "background": "surface", "minimum": 4.5},
    {"foreground": "accent-ink", "background": "accent", "minimum": 4.5},
