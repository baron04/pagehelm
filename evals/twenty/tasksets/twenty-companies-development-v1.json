      "prompt_template": "Which companies are currently in the CRM? List every company name and domain.",
      "parameters": {}
    },
    {
      "task_id": "dev-query-zh-1",
      "template_family": "dev-company-inventory-zh",
      "kind": "query",
      "prompt_template": "当前有哪些公司？请完整列出公司名称和域名。",
      "parameters": {}
    },
    {
      "task_id": "dev-open-en-1",
      "template_family": "dev-company-open-name-en",
      "kind": "open",
      "prompt_template": "Open the company record for {{company.name}}.",
      "parameters": {
        "baseline_index": 0
      }
    },
    {
      "task_id": "dev-open-zh-1",
      "template_family": "dev-company-open-domain-zh",
      "kind": "open",
      "prompt_template": "打开域名为 {{company.domain}} 的公司详情。",
      "parameters": {
        "baseline_index": 1
      }
    },
    {
      "task_id": "dev-create-en-1",
      "template_family": "dev-company-create-en",
      "kind": "create",
      "prompt_template": "Create a company named {{company.name}} with the domain {{company.domain}}, then open its record.",
      "parameters": {
        "name": "Evaluation Birch",
        "domain": "evaluation-birch.example.com",
        "require_open": true
      }
    },
    {
      "task_id": "dev-create-zh-1",
      "template_family": "dev-company-create-zh",
      "kind": "create",
      "prompt_template": "创建公司 {{company.name}}，域名是 {{company.domain}}。",
      "parameters": {
        "name": "Evaluation Cedar",
        "domain": "evaluation-cedar.example.com",
        "require_open": false
      }
    }
  ]
