# Copy to .env (`cp .env.example .env`) and configure your model below. Never commit .env.

# --- Option A: Cloud provider (derives official host & default model automatically) ---
# Fill one API key ("deepseek" -> deepseek-flash, "qwen" -> qwen3.8-flash, "openai" -> gpt-6.1-sol):
DEEPSEEK_API_KEY=
# DASHSCOPE_API_KEY=
# OPENAI_API_KEY=

# Optional: override host (base_url), model name, or provider explicitly:
AGENT_OPENAI_BASE_URL=
AGENT_OPENAI_MODEL=
# AGENT_PROVIDER=deepseek
# AGENT_OPENAI_API_KEY=

# --- Option B: Local Ollama (no API key or prices.json entry needed) ---
# AGENT_PROVIDER=ollama
# AGENT_OPENAI_MODEL=qwen3:14b
# OLLAMA_API_KEY=

# --- Option C: Private vLLM / LM Studio / OpenAI-compatible gateway ---
# AGENT_PROVIDER=openai-compatible
# AGENT_OPENAI_BASE_URL=https://vllm.internal.example/v1
# AGENT_OPENAI_MODEL=Qwen/Qwen3-32B
# AGENT_OPENAI_API_KEY=
# AGENT_MODEL_SELF_HOSTED=true

# --- Optional read-only kill-switch & host limits ---
# Form prefill and adapter-registered write tools/Skills are enabled by default
# (every write still requires human confirmation). Set WOA_READ_ONLY=true to disable all backend writes.
# WOA_READ_ONLY=true
# WOA_DAILY_ALLOWANCE_CNY=5.0
# WOA_DAILY_TOTAL_CAP_CNY=20.0
# WOA_MONTHLY_TOTAL_CAP_CNY=300.0
# WOA_MAX_SESSIONS=300
# WOA_TURN_TIMEOUT_S=120
