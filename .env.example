# Copy this file to .env. Keep real credentials in .env; it is ignored by Git.

# Model-backed runs (not needed with --scripted).
AGENT_OPENAI_BASE_URL=
AGENT_OPENAI_API_KEY=
AGENT_OPENAI_MODEL=
# AGENT_PROVIDER=

# Odoo demo and live qualification. `deploy provision` prints the exact values.
WOA_ODOO_BASE_URL=
WOA_ODOO_API_KEY_FILE=
WOA_ODOO_STORAGE_STATE=
WOA_ODOO_PAGE_CONTROLLER_MODULE=

# Optional: required only when typed writes are enabled.
# WOA_MUTATION_JOURNAL=.private/odoo/mutations.sqlite3

# Optional: enable source-backed Odoo citations.
# WOA_ODOO_SOURCE_ROOT=.fixture/odoo-source
# WOA_ODOO_SOURCE_RELEASE=
# WOA_ODOO_SOURCE_COMMIT=  # optional full Git commit; extracted image trees have no .git

# Optional: make the live gate restore and verify the disposable fixture.
# WOA_ODOO_FIXTURE_CONTAINER=
# WOA_ODOO_FIXTURE_DATABASE=woa_reference
# WOA_ODOO_FIXTURE_SNAPSHOT=.private/odoo/baseline.pgdump
# WOA_ODOO_FIXTURE_RECORD=.private/odoo/recovery.json

# Explicit integration opt-in; also enables approved native submission.
WOA_NATIVE_WRITES=false
